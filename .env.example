# Whence Configuration

# Environment: development, test, production
WHENCE_ENV=development

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security: Master AES-256-GCM key (32 bytes hex encoded or base64) for encrypting warehouse credentials at rest
# Generated example (do not use in production):
WHENCE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Warehouse Query Guardrails
MAX_BYTES_SCANNED_PER_QUERY=10737418240  # 10 GB limit in bytes
QUERY_TIMEOUT_SECONDS=60
WHENCE_QUERY_LABEL=whence

# LLM Provider Configuration (Section 9)
# Values will be supplied later; client is provider-agnostic
LLM_PROVIDER=gemini  # e.g., gemini, openai, anthropic, ollama
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_DAILY_TOKEN_LIMIT=500000

# Database Configuration (SQLite for local dev, Postgres compatible)
DATABASE_URL=sqlite:///./whence_local.db
